{
  "name": "HAPI ICU Admission",
  "remarks": [
    "Augmentation module: records ICU admission procedure for sepsis/septic shock patients.",
    "Guards on Or[Sepsis 91302008, Septic shock 76571007] — fires when Synthea generates these conditions.",
    "Sets is_icu_admitted=True in HAPI DSE extraction.",
    "Codes validated via https://tx.fhir.org/r4/CodeSystem/$validate-code:",
    "  SNOMED 305351004: Admit to ITU",
    "  SNOMED 32485007: Hospital admission"
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "ICU_Guard"
    },
    "ICU_Guard": {
      "type": "Guard",
      "allow": {
        "condition_type": "Or",
        "conditions": [
          {
            "condition_type": "Active Condition",
            "codes": [{ "system": "SNOMED-CT", "code": "91302008", "display": "Sepsis (disorder)" }]
          },
          {
            "condition_type": "Active Condition",
            "codes": [{ "system": "SNOMED-CT", "code": "76571007", "display": "Septic shock (disorder)" }]
          }
        ]
      },
      "direct_transition": "Inpatient_Encounter"
    },
    "Inpatient_Encounter": {
      "type": "Encounter",
      "encounter_class": "inpatient",
      "codes": [
        { "system": "SNOMED-CT", "code": "32485007", "display": "Hospital admission (procedure)" }
      ],
      "direct_transition": "ICU_Admission_Procedure"
    },
    "ICU_Admission_Procedure": {
      "type": "Procedure",
      "codes": [
        { "system": "SNOMED-CT", "code": "305351004", "display": "Admit to ITU" }
      ],
      "duration": { "low": 1, "high": 14, "unit": "days" },
      "direct_transition": "Encounter_End"
    },
    "Encounter_End": {
      "type": "EncounterEnd",
      "direct_transition": "Terminal"
    },
    "Terminal": {
      "type": "Terminal"
    }
  }
}
