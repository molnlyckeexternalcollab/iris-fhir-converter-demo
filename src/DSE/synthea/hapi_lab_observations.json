{
  "name": "HAPI Lab Observations",
  "remarks": [
    "Contextual augmentation module for the HAPI DSE risk calculator test data pipeline.",
    "NOT a disease module — does not model condition onset or alter population prevalence.",
    "",
    "Emits albumin, BUN, chloride, and RDW-CV lab observations for patients age >= 55.",
    "Patients are branched into three clinical archetypes based on active conditions:",
    "  High-risk:     Active systemic infection / sepsis (SNOMED 91302008 or 76571007)",
    "  Moderate-risk: Active heart failure (84114007) OR frailty (248279007)",
    "  Low-risk:      Age >= 55 but no qualifying high- or moderate-risk condition",
    "",
    "Every qualifying patient receives one inpatient encounter with two diagnostic panels:",
    "  - Metabolic panel (LOINC 24323-8): albumin, BUN, chloride",
    "  - CBC panel       (LOINC 58410-2): RDW-CV",
    "",
    "Value ranges per archetype (from HAPI DSE reference, validated 2026-07-22):",
    "  High-risk:     albumin 1.5-2.2 g/dL, BUN 40-80 mg/dL, Cl 92-99 mEq/L, RDW-CV 16.0-20.0 %",
    "  Moderate-risk: albumin 2.5-3.2 g/dL, BUN 22-35 mg/dL, Cl 96-102 mEq/L, RDW-CV 14.5-17.0 %",
    "  Low-risk:      albumin 3.2-4.0 g/dL, BUN 14-22 mg/dL, Cl 100-108 mEq/L, RDW-CV 12.5-14.5 %",
    "",
    "Braden scores cannot be generated by Synthea (nursing assessments).",
    "Derive them at extraction time from active condition codes per the hapi-labs.md reference.",
    "",
    "All LOINC and SNOMED codes validated against tx.fhir.org on 2026-07-22.",
    "Note: SNOMED 91302008 canonical display is 'Systemic infection' (not 'Sepsis') per tx.fhir.org."
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "Age_Guard"
    },
    "Age_Guard": {
      "type": "Guard",
      "allow": {
        "condition_type": "Age",
        "operator": ">=",
        "quantity": 55,
        "unit": "years"
      },
      "direct_transition": "Risk_Branch"
    },
    "Risk_Branch": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Or",
            "conditions": [
              {
                "condition_type": "Active Condition",
                "codes": [
                  {
                    "system": "SNOMED-CT",
                    "code": "91302008",
                    "display": "Systemic infection"
                  }
                ]
              },
              {
                "condition_type": "Active Condition",
                "codes": [
                  {
                    "system": "SNOMED-CT",
                    "code": "76571007",
                    "display": "Septic shock"
                  }
                ]
              }
            ]
          },
          "transition": "High_Risk_Encounter"
        },
        {
          "condition": {
            "condition_type": "Or",
            "conditions": [
              {
                "condition_type": "Active Condition",
                "codes": [
                  {
                    "system": "SNOMED-CT",
                    "code": "84114007",
                    "display": "Heart failure"
                  }
                ]
              },
              {
                "condition_type": "Active Condition",
                "codes": [
                  {
                    "system": "SNOMED-CT",
                    "code": "248279007",
                    "display": "Frailty"
                  }
                ]
              }
            ]
          },
          "transition": "Moderate_Risk_Encounter"
        },
        {
          "transition": "Low_Risk_Encounter"
        }
      ]
    },

    "High_Risk_Encounter": {
      "type": "Encounter",
      "encounter_class": "inpatient",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "32485007",
          "display": "Hospital admission"
        }
      ],
      "direct_transition": "High_Risk_Metabolic_Panel"
    },
    "High_Risk_Metabolic_Panel": {
      "type": "DiagnosticReport",
      "codes": [
        {
          "system": "LOINC",
          "code": "24323-8",
          "display": "Comprehensive metabolic 2000 panel - Serum or Plasma"
        }
      ],
      "observations": [
        {
          "category": "laboratory",
          "unit": "g/dL",
          "codes": [
            {
              "system": "LOINC",
              "code": "1751-7",
              "display": "Albumin [Mass/volume] in Serum or Plasma"
            }
          ],
          "range": { "low": 1.5, "high": 2.2 }
        },
        {
          "category": "laboratory",
          "unit": "mg/dL",
          "codes": [
            {
              "system": "LOINC",
              "code": "3094-0",
              "display": "Urea nitrogen [Mass/volume] in Serum or Plasma"
            }
          ],
          "range": { "low": 40, "high": 80 }
        },
        {
          "category": "laboratory",
          "unit": "mEq/L",
          "codes": [
            {
              "system": "LOINC",
              "code": "2075-0",
              "display": "Chloride [Moles/volume] in Serum or Plasma"
            }
          ],
          "range": { "low": 92, "high": 99 }
        }
      ],
      "target_encounter": "High_Risk_Encounter",
      "direct_transition": "High_Risk_CBC_Panel"
    },
    "High_Risk_CBC_Panel": {
      "type": "DiagnosticReport",
      "codes": [
        {
          "system": "LOINC",
          "code": "58410-2",
          "display": "CBC panel - Blood by Automated count"
        }
      ],
      "observations": [
        {
          "category": "laboratory",
          "unit": "%",
          "codes": [
            {
              "system": "LOINC",
              "code": "788-0",
              "display": "Erythrocyte [DistWidth] in Blood by Automated count"
            }
          ],
          "range": { "low": 16.0, "high": 20.0 }
        }
      ],
      "target_encounter": "High_Risk_Encounter",
      "direct_transition": "High_Risk_Encounter_End"
    },
    "High_Risk_Encounter_End": {
      "type": "EncounterEnd",
      "direct_transition": "Terminal"
    },

