    },
    "Severe_Immobile_Assessment": {
      "type": "Observation",
      "category": "survey",
      "unit": "{score}",
      "codes": [{ "system": "LOINC", "code": "38224-2", "display": "Physical mobility Braden scale" }],
      "exact": { "quantity": 1 },
      "target_encounter": "Severe_Profile_Encounter",
      "direct_transition": "Severe_Immobile_Moisture"
