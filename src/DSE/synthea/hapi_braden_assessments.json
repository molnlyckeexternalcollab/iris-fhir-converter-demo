{
  "name": "HAPI Braden Assessments",
  "remarks": [
    "Contextual augmentation module for synthetic HAPI nursing assessment data.",
    "This is not a disease module and does not alter disease prevalence.",
    "Eligibility requires age >= 55 and an active pressure-injury-risk or acute-care condition.",
    "Patients with age alone, seasonal influenza alone, diabetes alone, or abnormal HAPI laboratory values do not qualify.",
    "The module creates an inpatient encounter only after the eligibility guards pass.",
    "Generated values are synthetic test-data heuristics and do not represent actual nursing documentation.",
    "The five Braden domains use LOINC 38224-2, 38229-1, 38223-4, 38226-7, and 38222-6.",
    "Gait and transfer is a separate model feature using LOINC 93015-6 and values 0=normal, 10=weak, 20=impaired.",
    "Nutrition is not generated because it is not part of the current HAPI calculator input contract.",
    "Survey observations use numeric exact quantities with unit {score}; missing assessments are omitted rather than emitted as a literal value.",
    "All SNOMED-CT and LOINC codes were validated against tx.fhir.org on 2026-09-03.",
    "Built-in Synthea mappings include chronic congestive heart failure 88805009 and vertebral fracture with spinal cord injury 1734006; the project-specific HAPI mappings 84114007 and 90584004 remain supported.",
    "Severe profile: spinal cord injury, systemic infection, or septic shock; mostly immobile or very limited mobility and impaired or weak gait.",
    "Moderate profile: frailty or intensive care unit; moderately limited mobility and activity with weak gait.",
    "Mild profile: heart failure without a stronger risk context; slightly limited or full mobility with normal or weak gait.",
    "Moisture, friction, and sensory values are generated as explicit correlated synthetic assumptions within their documented score ranges."
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "Age_Guard"
    },
    "Age_Guard": {
      "type": "Guard",
      "allow": {
        "condition_type": "Age",
        "operator": ">=",
        "quantity": 55,
        "unit": "years"
      },
      "direct_transition": "Clinical_Eligibility_Guard"
    },
    "Clinical_Eligibility_Guard": {
      "type": "Guard",
      "allow": {
        "condition_type": "Or",
        "conditions": [
          { "condition_type": "Active Condition", "codes": [{ "system": "SNOMED-CT", "code": "248279007", "display": "Frailty" }] },
          { "condition_type": "Active Condition", "codes": [{ "system": "SNOMED-CT", "code": "91302008", "display": "Systemic infection" }] },
          { "condition_type": "Active Condition", "codes": [{ "system": "SNOMED-CT", "code": "76571007", "display": "Septic shock" }] },
          { "condition_type": "Active Condition", "codes": [{ "system": "SNOMED-CT", "code": "84114007", "display": "Heart failure" }] },
          { "condition_type": "Active Condition", "codes": [{ "system": "SNOMED-CT", "code": "88805009", "display": "Chronic congestive heart failure" }] },
          { "condition_type": "Active Condition", "codes": [{ "system": "SNOMED-CT", "code": "90584004", "display": "Spinal cord injury" }] },
          { "condition_type": "Active Condition", "codes": [{ "system": "SNOMED-CT", "code": "1734006", "display": "Fracture of vertebral column with spinal cord injury" }] },
          { "condition_type": "Active Condition", "codes": [{ "system": "SNOMED-CT", "code": "309904001", "display": "Intensive care unit" }] }
        ]
      },
      "direct_transition": "Risk_Profile_Branch"
    },
    "Risk_Profile_Branch": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Or",
            "conditions": [
              { "condition_type": "Active Condition", "codes": [{ "system": "SNOMED-CT", "code": "90584004", "display": "Spinal cord injury" }] },
              { "condition_type": "Active Condition", "codes": [{ "system": "SNOMED-CT", "code": "1734006", "display": "Fracture of vertebral column with spinal cord injury" }] },
              { "condition_type": "Active Condition", "codes": [{ "system": "SNOMED-CT", "code": "91302008", "display": "Systemic infection" }] },
              { "condition_type": "Active Condition", "codes": [{ "system": "SNOMED-CT", "code": "76571007", "display": "Septic shock" }] }
            ]
          },
          "transition": "Severe_Profile_Encounter"
        },
        {
          "condition": {
            "condition_type": "Or",
            "conditions": [
              { "condition_type": "Active Condition", "codes": [{ "system": "SNOMED-CT", "code": "248279007", "display": "Frailty" }] },
              { "condition_type": "Active Condition", "codes": [{ "system": "SNOMED-CT", "code": "309904001", "display": "Intensive care unit" }] }
            ]
          },
          "transition": "Moderate_Profile_Encounter"
        },
        {
          "condition": {
            "condition_type": "Or",
            "conditions": [
              { "condition_type": "Active Condition", "codes": [{ "system": "SNOMED-CT", "code": "84114007", "display": "Heart failure" }] },
              { "condition_type": "Active Condition", "codes": [{ "system": "SNOMED-CT", "code": "88805009", "display": "Chronic congestive heart failure" }] }
            ]
          },
          "transition": "Mild_Profile_Encounter"
        },
        { "transition": "Terminal" }
      ]
    },
    "Severe_Profile_Encounter": {
      "type": "Encounter",
      "encounter_class": "inpatient",
      "codes": [{ "system": "SNOMED-CT", "code": "32485007", "display": "Hospital admission" }],
      "direct_transition": "Severe_Profile_Branch"
    },
    "Severe_Profile_Branch": {
